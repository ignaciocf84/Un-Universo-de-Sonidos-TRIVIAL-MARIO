        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function toggleAudio() {
            soundEnabled = !soundEnabled;
            const btn = document.getElementById('btn-audio');
            const icon = document.getElementById('icon-audio');
            const label = document.getElementById('label-audio');

            if (soundEnabled) {
                icon.className = "fa-solid fa-volume-high text-indigo-600";
                label.innerText = "Sonido ON";
                btn.classList.remove('bg-slate-300');
                btn.classList.add('bg-slate-200');
                playClickSound();
            } else {
                icon.className = "fa-solid fa-volume-xmark text-rose-600";
                label.innerText = "Mute";
                btn.classList.add('bg-slate-300');
            }
        }

        function playClickSound() {
            if (!soundEnabled) return;
            initAudio();
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(200, audioCtx.currentTime + 0.05);
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.05);
            } catch(e){}
        }

        function playTickSound() {
            if (!soundEnabled) return;
            initAudio();
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'square';
                osc.frequency.setValueAtTime(800, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.04);
            } catch(e){}
        }

        function playTimeoutSound() {
            if (!soundEnabled) return;
            initAudio();
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, audioCtx.currentTime);
                osc.frequency.setValueAtTime(130, audioCtx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.4);
            } catch(e){}
        }

        function playCorrectSound() {
            if (!soundEnabled) return;
            initAudio();
            try {
                const now = audioCtx.currentTime;
                const notes = [523.25, 659.25, 783.99, 1046.50];
                notes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.08);
                    gain.gain.setValueAtTime(0.2, now + idx * 0.08);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.25);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now + idx * 0.08);
                    osc.stop(now + idx * 0.08 + 0.25);
                });
            } catch(e){}
        }

        function playWrongSound() {
            if (!soundEnabled) return;
            initAudio();
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(160, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.3);
            } catch(e){}
        }

        function playPointSound() {
            if (!soundEnabled) return;
            initAudio();
            try {
                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(987.77, now);
                osc.frequency.setValueAtTime(1318.51, now + 0.08);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.25);
            } catch(e){}
        }

        function playVictorySound() {
            if (!soundEnabled) return;
            initAudio();
            try {
                const now = audioCtx.currentTime;
                const notes = [523.25, 659.25, 783.99, 1046.50, 1318.51];
                notes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.1);
                    gain.gain.setValueAtTime(0.25, now + idx * 0.1);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.1 + 0.4);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now + idx * 0.1);
                    osc.stop(now + idx * 0.1 + 0.4);
                });
            } catch(e){}
        }

        /* ==========================================================================
           4. ALGORITMO FISHER-YATES SHUFFLE
           ========================================================================== */
        function shuffleArray(array) {
            const arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        /* ==========================================================================
           5. INICIALIZACIÓN Y CONTROL DEL JUEGO
           ========================================================================== */
        function initGame() {
            const shuffledDb = shuffleArray(originalQuestionsDatabase);
            
            activeQuestionsList = shuffledDb.slice(0, 20).map((q, idx) => {
                const shuffledOptions = shuffleArray(q.options);
                return {
                    ...q,
                    displayIndex: idx + 1,
                    shuffledOptions: shuffledOptions,
                    isCompleted: false,
                    selectedOption: null
                };
            });

            renderScoreboard();
            renderGrid();
            showGridView();
        }

        function resetGamePrompt() {
            playClickSound();
            if (confirm("¿Deseas reiniciar la partida? Se restaurarán las 20 preguntas al azar y la puntuación de los equipos.")) {
                teams.forEach(t => t.score = 0);
                initGame();
            }
        }

        /* ==========================================================================
           6. RENDERIZADO DEL MARCADOR DE 6 EQUIPOS
           ========================================================================== */
        function renderScoreboard() {
            const container = document.getElementById('teams-container');
            container.innerHTML = '';

            teams.forEach((team, index) => {
                const card = document.createElement('div');
                card.className = `glass-card p-3 rounded-2xl shadow-md border-t-4 ${team.border} flex flex-col justify-between items-center text-center space-y-2 transition-all hover:scale-105`;
                
                card.innerHTML = `
                    <div class="w-full flex items-center justify-between gap-1">
                        <span class="w-2.5 h-2.5 rounded-full ${team.color}"></span>
                        <input type="text" value="${team.name}" onchange="updateTeamName(${index}, this.value)" 
                            class="font-gorditas text-sm lg:text-base text-slate-900 bg-transparent text-center font-bold focus:bg-white focus:outline-indigo-500 rounded px-1 w-full border-b border-transparent hover:border-slate-300">
                    </div>
                    <div class="font-gorditas text-2xl lg:text-3xl text-slate-900 tracking-tight" id="score-team-${index}">
                        ${team.score} <span class="text-xs font-sans text-slate-500 font-bold">pts</span>
                    </div>
                    <div class="flex items-center justify-center gap-1 w-full">
                        <button onclick="adjustScore(${index}, 10)" class="bg-emerald-100 hover:bg-emerald-200 text-emerald-800 font-black text-xs px-2 py-1 rounded-lg transition shadow-sm">+10</button>
                        <button onclick="adjustScore(${index}, 5)" class="bg-sky-100 hover:bg-sky-200 text-sky-800 font-black text-xs px-2 py-1 rounded-lg transition shadow-sm">+5</button>
                        <button onclick="adjustScore(${index}, -5)" class="bg-rose-100 hover:bg-rose-200 text-rose-800 font-black text-xs px-2 py-1 rounded-lg transition shadow-sm">-5</button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function updateTeamName(index, newName) {
            if (newName.trim() !== '') {
                teams[index].name = newName.trim();
                renderQuickAwardButtons();
            }
        }

        function adjustScore(index, points) {
            playPointSound();
            teams[index].score += points;
            if (teams[index].score < 0) teams[index].score = 0;
            document.getElementById(`score-team-${index}`).innerHTML = `${teams[index].score} <span class="text-xs font-sans text-slate-500 font-bold">pts</span>`;
        }

        /* ==========================================================================
           7. VISTA 1: GRID GENERAL DE PREGUNTAS
           ========================================================================== */
        function renderGrid() {
            const grid = document.getElementById('questions-grid');
            grid.innerHTML = '';

            let completedCount = 0;

            activeQuestionsList.forEach((q, idx) => {
                if (q.isCompleted) completedCount++;

                const card = document.createElement('div');
                card.onclick = () => { playClickSound(); openQuestion(idx); };

                const completedStyles = q.isCompleted 
                    ? "bg-emerald-500/10 border-emerald-400 ring-2 ring-emerald-400/40 opacity-90" 
                    : "glass-card border-white hover:border-indigo-400 hover:shadow-xl hover:-translate-y-1";

                card.className = `p-4 rounded-2xl shadow-md cursor-pointer transition-all duration-200 relative flex flex-col justify-between h-36 border-2 ${completedStyles}`;

                card.innerHTML = `
                    <div class="flex justify-between items-start">
                        <span class="font-gorditas text-xl md:text-2xl text-indigo-950">#${q.displayIndex}</span>
                        ${q.isCompleted 
                            ? '<span class="bg-emerald-500 text-white w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold shadow"><i class="fa-solid fa-check"></i></span>' 
                            : '<span class="bg-indigo-100 text-indigo-800 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold"><i class="fa-solid fa-play text-indigo-600"></i></span>'}
                    </div>
                    <div>
                        <span class="text-[10px] md:text-xs font-black uppercase px-2 py-0.5 rounded-md border ${q.categoryColor} inline-block mb-1">
                            ${q.category}
                        </span>
                        <p class="text-xs font-bold text-slate-700 line-clamp-2">
                            ${q.question}
                        </p>
                    </div>
                `;
                grid.appendChild(card);
            });

            document.getElementById('progress-indicator').innerText = `Completadas: ${completedCount} / 20`;
        }

        function showGridView() {
            stopTimer();
            document.getElementById('view-grid').classList.remove('hidden');
            document.getElementById('view-question').classList.add('hidden');
            renderGrid();
        }

        /* ==========================================================================
           8. VISTA 2: PREGUNTA ACTIVA Y TEMPORIZADOR DE 10 SEGUNDOS
           ========================================================================== */
        function openQuestion(index) {
            currentQuestionIndex = index;
            const q = activeQuestionsList[index];

            document.getElementById('view-grid').classList.add('hidden');
            document.getElementById('view-question').classList.remove('hidden');

            document.getElementById('question-number-badge').innerText = `Pregunta ${q.displayIndex} / 20`;
            document.getElementById('question-category-badge').innerText = q.category;
            document.getElementById('question-category-badge').className = `px-4 py-1.5 rounded-full text-xs md:text-sm font-black uppercase tracking-wider border ${q.categoryColor}`;

            document.getElementById('question-text').innerText = q.question;

            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            const optionLetters = ['A', 'B', 'C', 'D'];

            q.shuffledOptions.forEach((optText, optIdx) => {
                const letter = optionLetters[optIdx];
                const btn = document.createElement('button');
                btn.className = `option-btn w-full text-left p-4 md:p-5 lg:p-6 rounded-2xl border-2 border-slate-200 bg-white hover:bg-indigo-50 hover:border-indigo-300 font-extrabold text-lg md:text-xl lg:text-2xl text-slate-800 shadow-sm transition-all flex items-center gap-4`;
                btn.onclick = () => handleOptionClick(optIdx, btn);

                btn.innerHTML = `
                    <span class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-indigo-100 text-indigo-900 font-gorditas flex items-center justify-center shrink-0 border border-indigo-200">
                        ${letter}
                    </span>
                    <span class="flex-grow">${optText}</span>
                    <span class="icon-status"></span>
                `;
                optionsContainer.appendChild(btn);
            });

            document.getElementById('explanation-box').classList.add('hidden');
            renderQuickAwardButtons();
            resetTimer();

            if (q.selectedOption !== null || q.isCompleted) {
                revealSolution();
            }
        }

        function handleOptionClick(optIndex, clickedBtn) {
            const q = activeQuestionsList[currentQuestionIndex];
            if (q.selectedOption !== null) return;

            stopTimer();
            q.selectedOption = optIndex;

            const selectedText = q.shuffledOptions[optIndex];
            const isCorrect = (selectedText === q.answer);

            if (isCorrect) {
                playCorrectSound();
            } else {
                playWrongSound();
            }

            revealSolution();
        }

        function revealSolution() {
            const q = activeQuestionsList[currentQuestionIndex];
            const buttons = document.querySelectorAll('.option-btn');
            
            buttons.forEach((btn, idx) => {
                btn.disabled = true;
                const text = q.shuffledOptions[idx];
                const iconSpan = btn.querySelector('.icon-status');

                if (text === q.answer) {
                    btn.className = "w-full text-left p-4 md:p-5 lg:p-6 rounded-2xl border-2 border-emerald-500 bg-emerald-50 font-extrabold text-lg md:text-xl lg:text-2xl text-emerald-950 shadow-md flex items-center gap-4";
                    iconSpan.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600 text-2xl"></i>`;
                } else if (q.selectedOption === idx) {
                    btn.className = "w-full text-left p-4 md:p-5 lg:p-6 rounded-2xl border-2 border-rose-500 bg-rose-50 font-extrabold text-lg md:text-xl lg:text-2xl text-rose-950 shadow-md flex items-center gap-4";
                    iconSpan.innerHTML = `<i class="fa-solid fa-circle-xmark text-rose-600 text-2xl"></i>`;
                } else {
                    btn.className = "w-full text-left p-4 md:p-5 lg:p-6 rounded-2xl border-2 border-slate-200 bg-slate-100 opacity-60 font-bold text-lg md:text-xl lg:text-2xl text-slate-700 flex items-center gap-4";
                }
            });

            const expBox = document.getElementById('explanation-box');
            const expTitle = document.getElementById('explanation-title');
            const expText = document.getElementById('explanation-text');

            expBox.classList.remove('hidden');
            expBox.className = "p-5 rounded-2xl border-2 bg-indigo-50/90 border-indigo-300 text-indigo-950 space-y-2 animate-pulse-subtle";
            expTitle.innerHTML = `<i class="fa-solid fa-lightbulb text-amber-500"></i> Solución: <strong>${q.answer}</strong>`;
            expText.innerText = q.explanation;
        }

        function renderQuickAwardButtons() {
            const container = document.getElementById('quick-award-buttons');
            container.innerHTML = '';

            teams.forEach((team, idx) => {
                const btn = document.createElement('button');
                btn.className = `${team.color} hover:brightness-110 font-extrabold py-2 px-3 rounded-xl text-sm transition shadow flex items-center justify-center gap-1.5`;
                btn.onclick = () => awardPointsToTeam(idx);
                btn.innerHTML = `<i class="fa-solid fa-plus text-xs"></i> ${team.name}`;
                container.appendChild(btn);
            });
        }

        function awardPointsToTeam(teamIndex) {
            adjustScore(teamIndex, 10);
            const q = activeQuestionsList[currentQuestionIndex];
            q.isCompleted = true;
            revealSolution();
        }

        function navigateQuestion(direction) {
            playClickSound();
            let newIndex = currentQuestionIndex + direction;
            if (newIndex < 0) newIndex = activeQuestionsList.length - 1;
            if (newIndex >= activeQuestionsList.length) newIndex = 0;
            openQuestion(newIndex);
        }

        /* ==========================================================================
           9. TEMPORIZADOR SONORO (10 SEGUNDOS)
           ========================================================================== */
        function startTimer() {
            if (isTimerRunning) return;
            initAudio();
            isTimerRunning = true;
            document.getElementById('btn-start-timer').classList.add('opacity-50');

            timerInterval = setInterval(() => {
                timerSeconds--;
                updateTimerUI();

                if (timerSeconds <= 3 && timerSeconds > 0) {
                    playTickSound();
                }

                if (timerSeconds <= 0) {
                    stopTimer();
                    playTimeoutSound();
                    revealSolution();
                }
            }, 1000);
        }

        function pauseTimer() {
            playClickSound();
            stopTimer();
        }

        function resetTimer() {
            stopTimer();
            timerSeconds = 10;
            updateTimerUI();
        }

        function stopTimer() {
            clearInterval(timerInterval);
            isTimerRunning = false;
            const btn = document.getElementById('btn-start-timer');
            if (btn) btn.classList.remove('opacity-50');
        }

        function updateTimerUI() {
            const display = document.getElementById('timer-display');
            const status = document.getElementById('timer-status');
            const bar = document.getElementById('timer-bar');

            display.innerText = timerSeconds;
            status.innerText = `${timerSeconds}s`;

            const percentage = (timerSeconds / 10) * 100;
            bar.style.width = `${percentage}%`;

            if (timerSeconds > 6) {
                bar.className = "bg-emerald-500 h-full rounded-full transition-all duration-1000";
                display.className = "bg-emerald-500 text-slate-950 font-gorditas text-2xl md:text-3xl w-14 h-14 rounded-xl flex items-center justify-center shadow-lg shrink-0";
            } else if (timerSeconds > 3) {
                bar.className = "bg-amber-500 h-full rounded-full transition-all duration-1000";
                display.className = "bg-amber-500 text-slate-950 font-gorditas text-2xl md:text-3xl w-14 h-14 rounded-xl flex items-center justify-center shadow-lg shrink-0";
            } else {
                bar.className = "bg-rose-500 h-full rounded-full transition-all duration-1000 animate-pulse";
                display.className = "bg-rose-500 text-white font-gorditas text-2xl md:text-3xl w-14 h-14 rounded-xl flex items-center justify-center shadow-lg shrink-0";
            }
        }

        /* ==========================================================================
           10. CLASIFICACIÓN / PODIO Y EFECTO CONFETI
           ========================================================================== */
        function showPodiumModal() {
            playVictorySound();
            fireConfettiEffect();

            const modal = document.getElementById('podium-modal');
            const list = document.getElementById('podium-list');
            list.innerHTML = '';

            const sortedTeams = [...teams].sort((a, b) => b.score - a.score);

            const medals = ['🏆', '🥈', '🥉', '4º', '5º', '6º'];
            const rankColors = [
                'bg-amber-100 border-amber-300 text-amber-950',
                'bg-slate-200 border-slate-400 text-slate-900',
                'bg-amber-800/10 border-amber-600/40 text-amber-900',
                'bg-slate-50 border-slate-200 text-slate-800',
                'bg-slate-50 border-slate-200 text-slate-800',
                'bg-slate-50 border-slate-200 text-slate-800'
            ];

            sortedTeams.forEach((team, index) => {
                const item = document.createElement('div');
                item.className = `p-4 rounded-2xl border-2 ${rankColors[index]} flex items-center justify-between shadow-sm`;

                item.innerHTML = `
                    <div class="flex items-center gap-3">
                        <span class="text-2xl font-gorditas">${medals[index]}</span>
                        <span class="font-gorditas text-lg md:text-xl">${team.name}</span>
                    </div>
                    <div class="font-gorditas text-2xl">
                        ${team.score} <span class="text-xs font-sans font-bold">pts</span>
                    </div>
                `;
                list.appendChild(item);
            });

            modal.classList.remove('hidden');
        }

        function closePodiumModal() {
            playClickSound();
            document.getElementById('podium-modal').classList.add('hidden');
        }

        function fireConfettiEffect() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 120,
                    spread: 80,
                    origin: { y: 0.6 }
                });
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            initGame();
        });
    </script>
